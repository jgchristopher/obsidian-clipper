{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSources": true,
		"module": "ESNext",
		"target": "es2021",
		"allowJs": true,
		// The base config turns on strict; keep the previous level for now.
		"strict": false,
		"noImplicitAny": true,
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"resolveJsonModule": true,
		"lib": ["DOM", "ES2021"],
		"types": ["svelte", "node"]
	},
	"include": ["**/*.ts", "**/*.svelte"]
}
