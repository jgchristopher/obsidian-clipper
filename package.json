{
	"name": "obsidian-clipper",
	"version": "1.0.0",
	"description": "This plugin helps you capture highlights from the web.",
	"main": "main.js",
	"packageManager": "pnpm@10.18.2",
	"scripts": {
		"compile": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"lint": "eslint .",
		"compile:bookmarklet": "tsc -skipLibCheck ./src/build/bookmarkletcode/index.ts",
		"build:bookmarklet": "pnpm run compile:bookmarklet && pnpm run webpack && ./node_modules/.bin/bookmarklet ./src/build/bookmarkletcode/dist/bookmarklet.js ./src/build/bookmarkletcode/dist/obsidian-clipper.min.js",
		"build:bookmarkletgen": "node ./src/bookmarkletlink/build-bookmarkletgenerator.js",
		"tailwindcss": "tailwindcss -i ./input.css -o ./styles.css",
		"version": "node ./src/build/version-bump.mjs && git add manifest.json versions.json",
		"webpack": "webpack",
		"build": "pnpm run build:bookmarklet && pnpm run build:bookmarkletgen && pnpm run compile && pnpm run tailwindcss && node esbuild.config.mjs production",
		"dev": "pnpm run build && pnpm run copy",
		"copy": "node testing/copy-to-vault.mjs",
		"clean": "rimraf ./src/build/bookmarkletcode/index.js && rimraf ./src/build/bookmarkletcode/obsidian-clipper.min.js && rimraf ./src/build/bookmarkletcode/dist/*",
		"seed-vault": "node testing/seed-vault.mjs",
		"sample-page": "python3 -m http.server 8765 --directory testing"
	},
	"keywords": [],
	"author": "jgchristopher",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "~9.39.5",
		"@eslint/json": "0.14.0",
		"@tsconfig/svelte": "5.0.8",
		"@types/node": "22.20.4",
		"@types/turndown": "5.0.6",
		"bookmarklet": "^3.0.0",
		"esbuild": "0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^10.11.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"moment": "^2.31.0",
		"obsidian": "1.8.7",
		"rimraf": "^6.1.3",
		"svelte": "5.57.1",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-popperjs": "^1.3.2",
		"svelte-writable-derived": "^3.1.1",
		"tailwindcss": "^3.4.19",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.1",
		"webpack": "^5.111.1",
		"webpack-cli": "^7.2.3"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "0.9.5",
		"parse-domain": "^8.4.0",
		"turndown": "7.2.4"
	}
}
